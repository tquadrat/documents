digraph {
  size="10,11"
  rankdir="BT"
  node [shape=box,style=filled,fillcolor="white"]
  
  subgraph {
    cluster=true
    bgcolor="white"
    labelloc=t # must be "t" for "top" because of the rankdir setting "BT"
    labeljust=r
    label="Domain Specific Exceptions"
    fontcolor="darkblue"
    
  domainrootexception [label="DomainException",fillcolor="lightyellow"]
  domainexception1    [label="…",fillcolor="lightyellow"]
  domainexception2    [label="…",fillcolor="lightyellow"]
  domainexception3    [label="…",fillcolor="lightyellow"]
  }

  throwable        [label="java.lang.Throwable"]
  error            [label="java.lang.Error"]
  exception        [label="java.lang.Exception"]
  runtimeexception [label="java.lang.RuntimeException"]
  wrapperexception [label="WrapperException",fillcolor="lightgrey"]
  
  {error,exception} -> throwable
  {domainexception1,domainexception2,domainexception3} -> domainrootexception -> wrapperexception -> runtimeexception -> exception
}

  {error,exception} -> throwable
  {runtimeexception,printingexception} -> exception
  {printingdataexception,printingdeviceexception,invalidprintingformatexception} -> printingexception
  {printingdatacorruptedexception,printingnodataexception,printingtoomuchdataexception} -> printingdataexception

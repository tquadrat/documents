digraph {
  size="10,11"
  rankdir="BT"
  node          [shape=box]
  throwable        [label="java.lang.Throwable"]
  error            [label="java.lang.Error"]
  exception        [label="java.lang.Exception"]
  runtimeexception [label="java.lang.RuntimeException"]
  
  printingexception [label="com.pega.PrintingException"]
  printingdeviceexception [label="com.pega.PrintingDeviceException"]
  nodeviceexception [label="com.pega.NoOutputDeviceException"]
  printingdataexception [label="com.pega.PrintingDataException"]
  printingdatacorruptedexception [label="com.pega.PrintingCorruptedDataException"]
  printingnodataexception [label="com.pega.PrintingNoDataException"]

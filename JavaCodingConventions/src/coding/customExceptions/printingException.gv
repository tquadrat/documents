digraph {
  size="10,11"
  rankdir="BT"
  node [shape=box,style=filled,fillcolor="white"]
  
  throwable                      [label="java.lang.Throwable"]
  error                          [label="java.lang.Error"]
  exception                      [label="java.lang.Exception"]
  runtimeexception               [label="java.lang.RuntimeException"]
  printingexception              [label="PrintingException",fillcolor="lightgrey"]
  printingdeviceexception        [label="PrintingDeviceException",fillcolor="lightgrey"]
  nodeviceexception              [label="NoOutputDeviceException",fillcolor="lightgrey"]
  printingdataexception          [label="PrintingDataException",fillcolor="lightgrey"]
  printingdatacorruptedexception [label="PrintingCorruptedDataException",fillcolor="lightgrey"]
  printingnodataexception        [label="PrintingNoDataException",fillcolor="lightgrey"]
  printingtoomuchdataexception   [label="PrintingTooMuchDataException",fillcolor="lightgrey"]
  invalidprintingformatexception [label="InvalidPrintingFormatException",fillcolor="lightgrey"]
  printingerror                  [label="PrintingError",fillcolor="lightgrey"]
  
  {error,exception} -> throwable
  printingexception -> runtimeexception -> exception
  {printingdataexception,printingdeviceexception,invalidprintingformatexception} -> printingexception
  {printingdatacorruptedexception,printingnodataexception,printingtoomuchdataexception} -> printingdataexception
  nodeviceexception -> printingdeviceexception
  
  printingerror -> error
}
